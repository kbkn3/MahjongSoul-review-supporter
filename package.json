{
  "name": "mahjongsoul-review-helper",
  "version": "1.3.1",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint components/ entrypoints/ utils/ --ext .js,.vue,.ts",
    "prepare": "wxt prepare",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "core-js": "^3.8.3",
    "csv-loader": "^3.0.3",
    "socket.io": "^4.8.1",
    "vue": "^3.2.37"
  },
  "devDependencies": {
    "@babel/core": "^7.14.3",
    "@babel/preset-env": "^7.14.4",
    "@types/chrome": "^0.1.3",
    "@types/webextension-polyfill": "^0.12.3",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vitest/coverage-v8": "^1.1.0",
    "@vue/compiler-sfc": "^3.0.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^6.7.2",
    "eslint-plugin-vue": "^7.5.0",
    "jsdom": "^23.0.0",
    "tailwindcss": "npm:@tailwindcss/postcss7-compat@^2.0.3",
    "typescript": "^5.9.2",
    "vite": "^5.4.19",
    "vitest": "^1.1.0",
    "wxt": "^0.18.15"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "browser": true,
      "webextensions": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 11,
      "sourceType": "module"
    },
    "overrides": [
      {
        "files": ["*.ts"],
        "parser": "@typescript-eslint/parser",
        "extends": ["plugin:@typescript-eslint/recommended"]
      }
    ],
    "rules": {}
  },
  "browser": {
    "fs": false
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "volta": {
    "node": "20.10.0"
  }
}
